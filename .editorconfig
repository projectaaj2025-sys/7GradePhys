root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md,json}]
indent_size = 2

# index.html — НЕ форматировать автоматически: внутри три base64-PDF,
# каждый уложен в одну строку (~360 000 символов). Перенос в такой строке
# ломает кнопку «Скачать конспект».
[*.html]
max_line_length = off

[{package.json,.github/**}]
trim_trailing_whitespace = true
